{% extends 'base.html.twig' %}

{% block title %}Stock de Guilde - Reliques{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="mb-4">
        <h1>🏛️ Stock de Guilde - Reliques</h1>
        <p class="text-muted">Consultez les reliques disponibles dans le stock de guilde</p>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('admin_guild_stock_index') }}" class="btn btn-primary">
                ⚙️ Gérer le stock (Admin)
            </a>
        {% endif %}
    </div>

    <div class="section-divider"></div>

    {# Bouton de prière #}
    <div class="mb-3">
        <button type="button" class="btn btn-{% if prayerActive %}warning{% else %}outline-secondary{% endif %} btn-lg" id="prayerButton" style="border: 3px solid {% if prayerActive %}#ffc107{% else %}#6c757d{% endif %}; font-weight: bold;">
            {% if prayerActive %}
                ✨ Prière ACTIVÉE (+1 niveau)
            {% else %}
                🙏 Activer la prière (+1 niveau)
            {% endif %}
        </button>
        {% if prayerActive %}
        <small class="text-muted ms-2">Tous les avatars gagnent +1 niveau de craft</small>
        {% endif %}
    </div>

    {% if stocks|length > 0 %}
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                <table id="stockTable" class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Icône</th>
                            <th>Relique</th>
                            <th>Quantité</th>
                            <th>Débloque</th>
                            <th>Craftable par</th>
                            <th>Lien</th>
                            <th>Dernière MAJ</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for stock in stocks %}
                            <tr>
                                <td>
                                    <img src="{{ stock.item.iconPath }}" alt="{{ stock.item.name['Fr'] ?? stock.item.name['En'] }}" width="32" height="32" loading="lazy">
                                </td>
                                <td>
                                    <strong class="{% if stock.item.quality == 'rare' %}text-primary{% elseif stock.item.quality == 'uncommon' %}text-success{% endif %}">
                                        {{ stock.item.name['Fr'] ?? stock.item.name['En'] ?? stock.item.externalId }}
                                    </strong>
                                </td>
                                <td>
                                    <span class="badge bg-{% if stock.quantity > 0 %}success{% else %}secondary{% endif %} fs-6">
                                        {{ stock.quantity }}
                                    </span>
                                </td>
                                <td>
                                    {% if recipes[stock.item.id] is defined %}
                                        {% set output = recipes[stock.item.id].output %}
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="{{ output.iconPath }}" alt="{{ output.name['Fr'] ?? output.name['En'] }}" width="24" height="24" loading="lazy">
                                            <a href="{{ path('item_show', {'id': output.id}) }}" class="text-reset text-decoration-none {% if output.quality == 'rare' %}text-primary{% elseif output.quality == 'uncommon' %}text-success{% endif %}">
                                                {{ output.name['Fr'] ?? output.name['En'] ?? output.externalId }}
                                            </a>
                                            {% if recipes[stock.item.id].outputQuantity %}
                                                <span class="badge bg-secondary">×{{ recipes[stock.item.id].outputQuantity }}</span>
                                            {% endif %}
                                        </div>
                                    {% else %}
                                        <span class="text-muted fst-italic">Aucune recette</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if craftableByAvatars[stock.item.id] is defined and craftableByAvatars[stock.item.id]|length > 0 %}
                                        <div class="d-flex flex-wrap gap-1">
                            {% for capable in craftableByAvatars[stock.item.id] %}
                                                <a href="{{ path('avatar_show', {'id': capable.avatar.id}) }}" 
                                                   class="badge bg-success text-decoration-none" 
                                                   title="{{ capable.avatar.name }} ({{ capable.avatar.user.username }}) - Niveau {{ capable.level }}{% if prayerActive %} (+1 prière = {{ capable.effectiveLevel }}){% endif %} - {{ (capable.probability * 100)|number_format(0) }}% de réussite">
                                                    {{ capable.avatar.name }} ({% if prayerActive %}{{ capable.effectiveLevel }}{% else %}{{ capable.level }}{% endif %})
                                                </a>
                                            {% endfor %}
                                        </div>
                                    {% else %}
                                        <span class="text-muted fst-italic">Aucun</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <a href="{{ stock.item.url }}" target="_blank" class="btn btn-sm btn-outline-primary">
                                        🔗 Voir
                                    </a>
                                </td>
                                <td>
                                    <small class="text-muted">{{ stock.updatedAt|date('d/m/Y H:i') }}</small>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                </div>
            </div>
        </div>
    {% else %}
        <div class="alert alert-info">
            <strong>ℹ️ Aucune relique en stock</strong>
            <p class="mb-0">Le stock de guilde est actuellement vide.</p>
        </div>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#stockTable').DataTable({
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/fr-FR.json'
                },
                order: [[5, 'desc']],
                pageLength: 25,
                scrollX: true,
                autoWidth: false
            });
            
            // Gérer le bouton de prière
            $('#prayerButton').on('click', function() {
                const params = new URLSearchParams(window.location.search);
                const currentPrayer = '{{ prayerActive ? "1" : "0" }}';
                
                if (currentPrayer === '1') {
                    // Désactiver la prière
                    params.delete('prayer');
                } else {
                    // Activer la prière
                    params.set('prayer', '1');
                }
                
                const url = '{{ path('guild_stock_index') }}' + (params.toString() ? '?' + params.toString() : '');
                window.location.href = url;
            });
        });
    </script>
{% endblock %}
