<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Pax Dei Market Checker{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🏰</text></svg>">
        
        {% block stylesheets %}
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
            <link rel="stylesheet" href="{{ asset('css/modern.css') }}">
        {% endblock %}

        {% block javascripts %}
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
        {% endblock %}
    </head>
    <body>
        <!-- Navigation -->
        <nav class="navbar navbar-expand-lg navbar-light sticky-top">
            <div class="container-fluid">
                <a class="navbar-brand" href="{{ path('market_items') }}">
                    🏰 Pax Dei Market
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('market_items') }}">🏪 Market</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('item_index') }}">📦 Items</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('spell_index') }}">✨ Spells</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('relic_mapping') }}">🔮 Reliques</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('avatar_index') }}">👤 Avatars</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('avatars_teleports_overview') }}">🗺️ Téléports</a>
                        </li>
                        <li class="nav-item">
                            {% if app.user %}
                                {% set unreadCount = app.user ? attribute(app.request.attributes.get('_route_params'), 'unreadCount')|default(0) : 0 %}
                                <a class="nav-link position-relative" href="{{ path('notifications_index') }}" id="notificationsNavLink">
                                    🔔 Notifications
                                    <span class="badge bg-danger position-absolute top-0 start-100 translate-middle" id="unreadBadge" style="display: none;">0</span>
                                </a>
                            {% else %}
                                <a class="nav-link" href="{{ path('notifications_index') }}">🔔 Notifications</a>
                            {% endif %}
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('equipment_set_index') }}">⚔️ Mes Sets</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('market_categories') }}">📊 Catégories</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('guild_stock_index') }}">🏛️ Stock Guilde</a>
                        </li>
                        {% if app.user %}
                            {% if app.user.userViews|length > 0 %}
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="viewsDropdown" role="button" data-bs-toggle="dropdown">
                                    📋 Mes vues
                                </a>
                                <ul class="dropdown-menu">
                                    {% for view in app.user.userViews %}
                                    <li>
                                        <a class="dropdown-item" href="{{ path('app_view_show', {id: view.id}) }}">
                                            {{ view.name }}
                                        </a>
                                    </li>
                                    {% endfor %}
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" href="{{ path('app_profile') }}">
                                            ⚙️ Gérer mes vues
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            {% endif %}
                        {% endif %}
                        {% if is_granted('ROLE_ADMIN') %}
                        <li class="nav-item">
                            <a class="nav-link" href="/admin">⚙️ Admin</a>
                        </li>
                        {% endif %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_profile') }}">👤 Profil</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_logout') }}">🚪 Déconnexion</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Flash Messages -->
        <!-- 
        <div class="container-fluid">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }} alert-dismissible fade show mt-3" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>
        -->

        <!-- Main Content -->
        {% block body %}{% endblock %}
        
        <!-- Script global pour mettre à jour le badge des notifications -->
        <script>
            function updateUnreadBadge() {
                fetch('/api/notifications/unread-count')
                    .then(response => response.json())
                    .then(data => {
                        const badge = document.getElementById('unreadBadge');
                        if (badge && data.count !== undefined) {
                            if (data.count > 0) {
                                badge.textContent = data.count > 99 ? '99+' : data.count;
                                badge.style.display = 'inline-block';
                            } else {
                                badge.style.display = 'none';
                            }
                        }
                    })
                    .catch(error => console.error('Error fetching unread count:', error));
            }

            // Mettre à jour le badge au chargement de la page
            document.addEventListener('DOMContentLoaded', function() {
                updateUnreadBadge();
            });
        </script>
    </body>
</html>
